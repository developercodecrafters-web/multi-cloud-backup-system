# AWS S3 (optional if you use Google Drive)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Google Drive (optional if you use AWS S3)
# Absolute path to service account JSON key file
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Optional default folder ID if you want to pre-fill from env in custom scripts
GOOGLE_DRIVE_FOLDER_ID=

# Google Drive OAuth client flow (recommended for personal Drive uploads)
# Absolute path to OAuth client JSON downloaded from Google Cloud
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET_FILE=
# Token cache file path (created automatically after first auth)
GOOGLE_DRIVE_OAUTH_TOKEN_FILE=google_drive_token.json
# Local callback port used during OAuth browser sign-in
GOOGLE_DRIVE_OAUTH_LOCAL_SERVER_PORT=8080
